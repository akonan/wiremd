{
  "name": "wiremd-preview",
  "displayName": "Wiremd Preview",
  "description": "Render wiremd code fences inside VS Code Markdown preview",
  "version": "0.1.0",
  "publisher": "wiremd",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "wireframe",
    "mockup",
    "preview",
    "design"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdown.showPreview",
    "onCommand:markdown.showPreviewToSide",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE.txt",
    "package.json"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "bundle": "rm -rf dist && esbuild ./src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap",
    "compile": "npm run typecheck && npm run bundle",
    "watch": "esbuild ./src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap --watch",
    "typecheck": "tsc --noEmit -p ./",
    "package": "npm run compile && vsce package",
    "lint": "eslint src --ext ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.10",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "wiremd": "file:./wiremd-0.1.5.tgz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akonan/wiremd.git",
    "directory": "vscode-extension"
  },
  "license": "MIT"
}
